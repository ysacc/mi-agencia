{
  "name": "mi-agencia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node tests/prepare.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src/App.tsx src/App.css src/main.tsx src/components/WebUi.tsx src/components/WebQuote.tsx src/data/plans.ts src/data/webFaq.ts vite.config.ts tests public/demos"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/aos": "^3.0.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  }
